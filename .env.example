# Directory Paths
VECTOR_DB_DIR=./data/vector_db
RAW_DOCS_DIR=./data/raw_documents
MODEL_PATH=./models/tf_classifier.h5
TOKENIZER_PATH=./models/tokenizer.pickle
DB_URL=sqlite:///./data/metadata.db

# LLM Configuration (Options: gemini, openai, ollama)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Embeddings Configuration (Options: huggingface, openai, gemini)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Keys (Provide if using openai or gemini providers)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Settings (If using local ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3

# Security Settings
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
